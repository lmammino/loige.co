---
/// <reference path="../../.astro/types.d.ts" />

import { Leaflet, Marker, Popup, Tooltip } from "astro-leaflet";
import type { LatLngTuple } from 'astro-leaflet/leaflet'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { SITE_TITLE } from '../consts'
import CommonLayout from '../layouts/CommonLayout.astro'
import SpeakingEntry from '../components/SpeakingEntry.astro'
import Prose from '../components/Prose.astro'

interface ImageFile {
  default: ImageMetadata
}

const speakingPics = import.meta.glob<ImageFile>('../assets/speaking/*', {
  eager: true,
})
const shuffledSpeakingPics = Object.values(speakingPics).sort(
  () => 0.5 - Math.random(),
)

type Props = CollectionEntry<'speaking'>

const speaking = (await getCollection('speaking')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const firstYear = speaking[speaking.length - 1].data.date.getFullYear()
const now = new Date()
const futureTalks = speaking
  .filter((s) => s.data.date > now)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
const pastTalks = speaking.filter((s) => s.data.date <= now)
const pastTalksByYear = Object.entries(
  pastTalks.reduce(
    (acc, s) => {
      const year = s.data.date.getFullYear()
      if (!acc[year]) {
        acc[year] = []
      }
      acc[year].push(s)
      return acc
    },
    {} as Record<number, Props[]>,
  ),
).sort((a, b) => (b as any)[0] - (a as any)[0])

const locations = new Set(
  pastTalks.map((s) => s.data.event_city).filter((l) => !!l),
)
const countries = new Set(
  [...locations].map((s) => (s as string).split(', ')[1]).filter((l) => !!l),
)

// Histogram data: count of talks per year, split into past and upcoming.
// The current (and any future) year can carry a translucent "upcoming" stack
// on top of the delivered count.
const currentYear = now.getFullYear()
const histogramRangeEnd = Math.max(
  currentYear,
  ...futureTalks.map((t) => t.data.date.getFullYear()),
)
const histogramData: {
  year: number
  past: number
  upcoming: number
  total: number
}[] = []
for (let y = firstYear; y <= histogramRangeEnd; y++) {
  const past = pastTalks.filter((t) => t.data.date.getFullYear() === y).length
  const upcoming = futureTalks.filter(
    (t) => t.data.date.getFullYear() === y,
  ).length
  histogramData.push({ year: y, past, upcoming, total: past + upcoming })
}
const histogramMax = Math.max(1, ...histogramData.map((d) => d.total))
const hasUpcomingInHistogram = histogramData.some((d) => d.upcoming > 0)
---

<CommonLayout
  section="speaking"
  seo={{
    title: `${SITE_TITLE} - Speaking activity`,
    description: `Speaking activity of Luciano Mammino, past and upcoming talks and workshops in conferences and meetups. With slides and video links where available.`,
  }}
>
  <div class="relative bg-bg-500">
    <div
      class="mx-auto max-w-(--breakpoint-xl) pt-8 pb-2 sm:pb-8 md:pb-16 px-8 z-20 flex flex-col justify-center items-center"
    >
      <h1 class="text-4xl text-center my-8 font-bold text-text-500"
        >Luciano Mammino's talks</h1
      >
      <Prose>
        <p
          >I am quite involved with technical speaking and I love delivering
          talks and workshops at conferences and meetups.</p
        >
        <p
          >Since <strong>{firstYear}</strong>, I have delivered <strong
            >{pastTalks.length}</strong
          > talks in
          <strong>{countries.size}</strong> different countries. In this page you
          can find my upcoming talks and all the past ones (with slides and videos,
          when available).</p
        >
        <p
          >If you think I can be a good suit to talk or host a workshop, you can
          <a
            rel="nofollow noreferrer noopener"
            target="_blank"
            href="http://loige.link/invite-me-to-a-conference"
            >invite me to your next event</a
          >.</p
        >
      </Prose>
    </div>
  </div>

  <div
    class="relative overflow-x-clip py-4 sm:py-6 lg:py-10 bg-bg-500 [background:radial-gradient(circle_at_30%_60%,_var(--color-primary-200)_0%,transparent_30%),radial-gradient(circle_at_80%_90%,_var(--color-secondary-300)_0%,transparent_30%),radial-gradient(circle_at_bottom,_var(--color-accent-300)_0%,var(--color-bg-500)_60%)]"
  >
    <div class="flex justify-center w-full">
      <div
        class="absolute h-[500px] hidden xl:grid grid-cols-3 grid-rows-2 w-full xl:max-w-(--breakpoint-xl) xl:mx-auto z-10 justify-center content-center place-items-center"
      >
        <div class="relative rotate-2 top-[-182px] left-[-220px]">
          <Image
            src={shuffledSpeakingPics[0].default}
            width="200"
            height="150"
            alt="A photo of Luciano Mammino talking at a conference"
            class="z-10 rounded-xl shadow-xl parallax animate-[200ms_ease-in-out_0ms_slide-left]"
          />
        </div>

        <div class="relative -rotate-2 top-[-142px] right-[50%]">
          <Image
            src={shuffledSpeakingPics[1].default}
            width="160"
            height="120"
            alt="A photo of Luciano Mammino talking at a conference"
            class="z-10 rounded-xl shadow-xl parallax animate-[200ms_ease-in-out_10ms_slide-up]"
          />
        </div>

        <div class="relative -rotate-3 top-[12px] right-[-300px]">
          <Image
            src={shuffledSpeakingPics[2].default}
            width="240"
            height="180"
            alt="A photo of Luciano Mammino talking at a conference"
            class="z-10 rounded-xl shadow-xl parallax animate-[200ms_ease-in-out_20ms_slide-right]"
          />
        </div>

        <div class="relative -rotate-2 top-[182px] left-[-10%]">
          <Image
            src={shuffledSpeakingPics[3].default}
            width="160"
            height="120"
            alt="A photo of Luciano Mammino talking at a conference"
            class="z-10 rounded-xl shadow-xl parallax animate-[200ms_ease-in-out_30ms_slide-left]"
          />
        </div>

        <div class="relative -rotate-2 top-[182px] left-[50%]">
          <Image
            src={shuffledSpeakingPics[4].default}
            width="240"
            height="180"
            alt="A photo of Luciano Mammino talking at a conference"
            class="z-10 rounded-xl shadow-xl parallax animate-[200ms_ease-in-out_40ms_slide-down]"
          />
        </div>

        <div class="relative rotate-12 top-[120px] right-[-220px]">
          <Image
            src={shuffledSpeakingPics[5].default}
            width="200"
            height="150"
            alt="A photo of Luciano Mammino talking at a conference"
            class="z-10 rounded-xl shadow-xl parallax animate-[200ms_ease-in-out_50ms_slide-right]"
          />
        </div>
      </div>
    </div>

    <div
      class="z-30 h-[300px] sm:h-[500px] w-full object-cover xl:max-w-(--breakpoint-xl) xl:mx-auto xl:rounded-xl shadow-lg bg-primary-400"
    >
      <Leaflet
        options={{
          tileLayerOptions: {
            maxZoom: 19,
          },
          center: [45, -40],
          zoom: 3,
        }}
        id="speaking_map"
        class="z-30 h-full xl:rounded-xl xl:border-4 xl:border-bg-700"
        style="width: 100%; height: 100%;"
      >
        { speaking.map((s) => {
          if (s.data.event_location_gps) {
            const coords = s.data.event_location_gps.split(',').map(parseFloat) as LatLngTuple
            const content = `<small>${s.data.date.toDateString()}</small><br/><strong>${s.data.title}</strong><br/>${s.data.event_city}`
            return (
              <Marker latlng={coords}>
                <Popup content={content}/>
                <Tooltip content={content}/>
              </Marker>
            )
          }
        })}
      </Leaflet>
    </div>
  </div>

  <!-- Talks-per-year histogram.
       Each bar is a link to that year's anchor in the Past talks list. -->
  <div class="relative bg-bg-500">
    <div class="mx-auto max-w-(--breakpoint-xl) pt-2 sm:pt-8 md:pt-24 px-8">
      <h2 class="text-text-500 text-3xl font-bold mb-2">Talks per year</h2>
      <p class="text-text-400 mb-6">
        <strong>{pastTalks.length}</strong> talks delivered since{' '}
        <strong>{firstYear}</strong>{
          futureTalks.length > 0 && (
            <>
              {' '}· <strong>{futureTalks.length}</strong> upcoming
            </>
          )
        }. Click a year to jump.
      </p>
      <figure class="w-full">
        <div class="w-full overflow-x-auto pb-2">
          <ol
            class="flex items-end gap-1 sm:gap-2 h-48 bg-bg-300 border border-bg-600 rounded-lg p-4 min-w-[640px]"
            aria-label={`Talks per year from ${firstYear} to ${histogramRangeEnd}`}
          >
            {
              histogramData.map((d) => {
                const heightPct =
                  d.total > 0
                    ? Math.max(6, (d.total / histogramMax) * 100)
                    : 0
                const upcomingPct =
                  d.total > 0 ? (d.upcoming / d.total) * 100 : 0
                const label = `${d.total} talk${d.total !== 1 ? 's' : ''} in ${d.year}${d.upcoming > 0 ? ` (${d.upcoming} upcoming)` : ''}`
                const isCurrent = d.year === currentYear
                return (
                  <li class="flex-1 h-full flex flex-col items-center justify-end group">
                    <a
                      href={d.past > 0 ? `#talks-${d.year}` : '#upcoming'}
                      aria-label={label}
                      title={label}
                      class="relative w-full flex flex-col justify-end h-full rounded-sm"
                    >
                      <span class="text-xs text-text-500 font-bold text-center mb-1 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity">
                        {d.total || ''}
                      </span>
                      {d.total > 0 ? (
                        <span
                          class="relative w-full bg-accent-500 group-hover:bg-accent-600 transition-colors rounded-t-sm overflow-hidden shadow-sm"
                          style={`height: ${heightPct}%`}
                        >
                          {d.upcoming > 0 && (
                            <span
                              class="absolute top-0 inset-x-0 bg-primary-500/50 border-b border-primary-700/40"
                              style={`height: ${upcomingPct}%`}
                              aria-hidden="true"
                            />
                          )}
                        </span>
                      ) : (
                        <span
                          class="block w-full border-b-2 border-dashed border-bg-600 group-hover:border-text-300 transition-colors"
                          aria-hidden="true"
                        />
                      )}
                    </a>
                    <span
                      class={`mt-2 text-xs font-mono ${isCurrent ? 'text-text-500 font-bold' : 'text-text-400'}`}
                    >
                      {d.year}
                    </span>
                  </li>
                )
              })
            }
          </ol>
        </div>
        {
          hasUpcomingInHistogram && (
            <figcaption class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-text-400">
              <span class="inline-flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-sm bg-accent-500" />
                Delivered
              </span>
              <span class="inline-flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-sm bg-primary-500/50 border border-primary-700/40" />
                Upcoming
              </span>
            </figcaption>
          )
        }
      </figure>
    </div>
  </div>

  <div class="relative bg-bg-500">
    <div
      id="upcoming"
      class="mx-auto max-w-(--breakpoint-xl) pt-2 sm:pt-8 md:pt-16 pb-8 px-8 z-20 flex flex-col justify-center items-center"
    >
      <h2 class="text-text-500 text-3xl text-left w-full my-8 font-bold"
        >Upcoming talks</h2
      >
      <div class="w-full">
        {
          futureTalks.length === 0 ? (
            <div class="w-full border-l-4 border-accent-500 bg-bg-300 rounded-r-lg p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
              <div class="flex-1">
                <h3 class="text-text-500 text-xl md:text-2xl font-bold mb-2">
                  Bummer! No upcoming talks scheduled
                </h3>
                <p class="text-text-400">
                  Planning a conference, meetup, or internal event? I'd love
                  to hear about it.
                </p>
              </div>
              <a
                href="http://loige.link/invite-me-to-a-conference"
                rel="nofollow noreferrer noopener"
                target="_blank"
                class="inline-flex items-center justify-center gap-2 bg-accent-500 hover:bg-accent-600 text-display-bg border-2 border-accent-600 hover:border-accent-700 px-5 py-2.5 min-h-[44px] rounded-lg font-bold shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-[var(--duration-base)] ease-[var(--ease-standard)] flex-shrink-0 whitespace-nowrap"
              >
                Invite me →
              </a>
            </div>
          ) : (
            <ul class="flex flex-col gap-4 w-full">
              {futureTalks.map((t) => (
                <SpeakingEntry entry={t} />
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>

  <div class="relative bg-bg-500 pb-16">
    <div
      class="mx-auto max-w-(--breakpoint-xl) px-8 z-20 flex flex-col justify-center items-center"
    >
      <h2 class="text-text-500 text-3xl text-left w-full mt-8 font-bold"
        >Past talks</h2
      >
      {
        pastTalksByYear.map(([year, pastTalks]) => (
          <div id={`talks-${year}`} class="w-full mt-16 first-of-type:mt-8">
            <h3 class="text-text-400 font-bold text-2xl mb-4">{year}</h3>
            <ul class="flex flex-col gap-4 w-full">
              {pastTalks.map((t) => (
                <SpeakingEntry entry={t} />
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</CommonLayout>

<script>
  // Parallax effect
  document.addEventListener('mousemove', parallax)
  const elem = document.querySelectorAll('.parallax')
  // Magic happens here
  function parallax(e: MouseEvent) {
    let w = window.innerWidth / 2
    let h = window.innerHeight / 2
    let mouseX = e.clientX
    let mouseY = e.clientY
    let x = (mouseX - w) * 0.01
    let y = (mouseY - h) * 0.01
    ;[...elem].forEach((el: Element) => {
      ;(el as HTMLImageElement).style.transform = `translate(${x}px, ${y}px)`
    })
  }
</script>
